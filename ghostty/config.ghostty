shell-integration = zsh
command = zsh
theme = dark:Catppuccin Macchiato, light:iTerm2 Solarized Light

# Optional override written by a theme switcher; the ? makes a missing file silent.
config-file = ?auto/theme.ghostty
font-family = JetBrainsMono Nerd Font
font-size = 11

unfocused-split-opacity = 0.5
window-inherit-working-directory = true
confirm-close-surface = false

window-padding-x = 8
window-padding-y = 8
window-padding-color = background

### Keybindings

## Splits
keybind = alt+v=new_split:right
keybind = alt+s=new_split:down
keybind = alt+w=close_surface

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+p=goto_split:previous

keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10
keybind = alt+zero=equalize_splits
keybind = alt+z=toggle_split_zoom

## Tabs
keybind = alt+t=new_tab
keybind = alt+digit_8=previous_tab
keybind = alt+digit_9=next_tab
keybind = alt+shift+digit_8=move_tab:-1
keybind = alt+shift+digit_9=move_tab:1
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
